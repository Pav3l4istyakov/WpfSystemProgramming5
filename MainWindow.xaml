<Window x:Class="WpfSystemProgramming5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSystemProgramming5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
            
            <Button Content="Запустить гонку данных" Click="RaceData_Click"/>
            <Button Content="Запустить безопасное добавление" Click="SafeAdd_Click"/>
            <Button Content="Проверить монитор с таймаутом" Click="MonitorTimeout_Click"/>
            <Label Name="raceResult" FontSize="18"/>
            <Label Name="safeResult" FontSize="18"/>
            <Label Name="monitorResult" FontSize="18"/>
        </StackPanel>
    </Grid>
</Window>
